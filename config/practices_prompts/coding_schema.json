{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evidence_id",
    "practices",
    "motivations",
    "visions",
    "motivation_status",
    "vision_status",
    "uncodable",
    "review_flag",
    "review_reason",
    "emerging_themes"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "practices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category_id": {
            "type": "string",
            "enum": [
              "P01",
              "P02",
              "P03",
              "P04",
              "P05",
              "P06",
              "P07",
              "P08",
              "P09",
              "P10",
              "P11",
              "P12"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 8
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "category_id",
          "quote",
          "explanation"
        ]
      }
    },
    "motivations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category_id": {
            "type": "string",
            "enum": [
              "M01",
              "M02",
              "M03",
              "M04",
              "M05",
              "M06",
              "M07",
              "M08",
              "M09"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 8
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "explicitness": {
            "enum": [
              "Explicit",
              "Implicit"
            ]
          },
          "relationship_quote": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "category_id",
          "quote",
          "explanation",
          "explicitness",
          "relationship_quote"
        ]
      }
    },
    "visions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category_id": {
            "type": "string",
            "enum": [
              "V01",
              "V02",
              "V03",
              "V04",
              "V05",
              "V06",
              "V07",
              "V08",
              "V09"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 8
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "explicitness": {
            "enum": [
              "Explicit",
              "Implicit"
            ]
          },
          "relationship_quote": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "category_id",
          "quote",
          "explanation",
          "explicitness",
          "relationship_quote"
        ]
      }
    },
    "motivation_status": {
      "enum": [
        "Explicit",
        "Implicit",
        "Mixed",
        "Not Disclosed",
        "Uncertain"
      ]
    },
    "vision_status": {
      "enum": [
        "Explicit",
        "Implicit",
        "Mixed",
        "Not Disclosed",
        "Uncertain"
      ]
    },
    "uncodable": {
      "type": "boolean"
    },
    "review_flag": {
      "type": "boolean"
    },
    "review_reason": {
      "type": "string"
    },
    "emerging_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "theme",
          "quote",
          "explanation"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "practices",
              "motivations",
              "visions"
            ]
          },
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 8
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Custom Python validator additionally checks exact source quotations, unique/dimension-correct IDs, relationship quotes and status consistency. Offline tests exercise research-critical constraints."
}